{
    "venvPath": ".",
    "venv": ".venv",

    // enforce convention of using underscore prefix as private
    // goal: simplify identifying private members in Python modules without Shift+F12
    // - that said, flagging usages is not necessary for my goal, so remove these if they're distracting
    // - i.e. I still intend to use private members in some test cases
    "reportPrivateUsage": "information",
    "reportPrivateImportUsage": "information",

    "reportImplicitStringConcatenation": "none",

    "reportImplicitRelativeImport": "hint",

    // is it just me or are these insane diagnostics to have on warning by default?!
    // these basically underline all code unless (anything untyped)
    "reportUnknownParameterType": "none",
    "reportMissingParameterType": "none",
    "reportUnknownVariableType": "none",
    "reportUnknownArgumentType": "none",
    "reportUnknownMemberType": "none",
    "reportAny": "none", // usage of Any is a report?!
    "reportMissingTypeStubs": "none", // WTF requires a stub file for libraries?

    "reportUnusedCallResult": "none", // WTF WHO CARES if I call method and don't use its return value?

    "extraPaths": [
        // deliberatiely redundant (../dotfiles) to copy pasta this into any of my repos
        "../dotfiles/.config/xonsh/lib",
        "../dotfiles/xonsh",
        // so `import wes.syntax` resolves from anywhere in the repo
        // (it's an editable install whose finder pyright can't follow)
        "tools/wes_package",
    ]
}
