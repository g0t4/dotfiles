#!/usr/bin/env python3

import subprocess
import sys
from pathlib import Path


git_dir_result = subprocess.run(
    ["git", "rev-parse", "--git-dir"], capture_output=True, text=True
)
if git_dir_result.returncode == 0:
    git_dir = Path(git_dir_result.stdout.strip())
    if not any(
        path.exists()
        for path in (git_dir / "rebase-merge", git_dir / "rebase-apply", git_dir / "MERGE_HEAD")
    ):
        subprocess.run([sys.executable, Path(__file__).with_name("core.py")], check=False)
