#!/usr/bin/env python3

import subprocess
import sys
from pathlib import Path


# Git passes the rewrite command as argv[1]: currently `amend` or `rebase`.
# Amend already invokes post-commit, so only rebase needs shared work here.
rewrite_command = sys.argv[1]
shared_hook = Path(__file__).with_name("core.py")

if rewrite_command != "amend":
    subprocess.run([sys.executable, shared_hook], check=False)
